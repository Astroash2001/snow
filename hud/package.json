{
  "name": "snow-hud",
  "version": "0.1.0",
  "private": true,
  "description": "Snow HUD: Electron shell and React renderer, a pure WebSocket client of the hub",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:types": "json2ts -i ../contracts/events.schema.json -o src/generated/contracts.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "electron": "44.7.2",
    "electron-vite": "6.0.0",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
